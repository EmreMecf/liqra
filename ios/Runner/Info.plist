<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>

		<!-- Ana ekranda görünen ad. Flutter şablonundan kalan "Muhasebe"
		     değeriyle mağazaya çıkılırsa kullanıcı Liqra yerine onu görür. -->
		<key>CFBundleDisplayName</key>
		<string>Liqra</string>
		<key>CFBundleName</key>
		<string>Liqra</string>

		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>

		<!-- ── İzin açıklamaları ────────────────────────────────────────────
		     Bunlar OLMADAN iOS uygulamayı ÇÖKERTİR (kullanıcı reddedemez,
		     sistem doğrudan sonlandırır) ve App Store incelemesi reddeder.
		     Metinler Türkçe ve amacı açık olmalı — "erişim gerekiyor" gibi
		     genel ifadeler reddedilme sebebidir. -->
		<key>NSCameraUsageDescription</key>
		<string>Fiş ve faturalarınızı okuyup harcama olarak kaydedebilmek için kameraya erişmemiz gerekiyor. Görseller yalnızca metne dönüştürülür.</string>

		<key>NSPhotoLibraryUsageDescription</key>
		<string>Galerinizden fiş, fatura veya hesap ekstresi seçebilmeniz için fotoğraflarınıza erişmemiz gerekiyor.</string>

		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Oluşturduğunuz raporları galerinize kaydedebilmek için izin gerekiyor.</string>

		<key>NSFaceIDUsageDescription</key>
		<string>Uygulamayı biyometrik kilitle açabilmeniz için Face ID kullanılır.</string>

		<!-- Liqra konum bilgisi toplamaz ve kullanıcıdan konum izni istemez.
		     Bu anahtar yalnızca Apple'ın yükleme doğrulaması (uyarı 90683)
		     için var: bağlı SDK'lardan biri konum API'lerine referans
		     verdiğinden, kullanılmasa bile amaç metni zorunlu tutuluyor.
		     Konum istenmediği için kullanıcı bu metni hiçbir zaman görmez. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Liqra konumunuzu kullanmaz. Bu izin yalnızca uygulamanın kullandığı bir kütüphanenin gereksinimi nedeniyle tanımlıdır ve sizden konum bilgisi istenmez.</string>

		<!-- ── Arka plan ────────────────────────────────────────────────────
		     FCM bildirimlerinin uygulama kapalıyken de gelmesi için gerekli. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
			<string>fetch</string>
		</array>

		<!-- ── Google ile giriş ─────────────────────────────────────────────
		     GoogleService-Info.plist UYGULAMA PAKETİNE DAHİL DEĞİL: dosya
		     Xcode projesine kayıtlı olmadığı için derlemede paketlenmiyor.
		     Firebase bundan etkilenmiyor (yapılandırmayı firebase_options.dart
		     içinden alıyor) ama google_sign_in istemci kimliğini plist'ten
		     okumaya çalışıyor; bulamayınca butona basıldığı anda uygulama
		     ÇÖKÜYORDU.

		     Çözüm: kimlik doğrudan Info.plist'e yazılıyor. Her iki değer de
		     derleme sırasında GoogleService-Info.plist'ten okunup yerine
		     konuyor (codemagic.yaml → prepare_ios), böylece Firebase
		     yapılandırması yenilendiğinde elle senkron tutmak gerekmiyor. -->
		<key>GIDClientID</key>
		<string>GID_CLIENT_ID_YER_TUTUCU</string>

		<!-- Tarayıcıdan uygulamaya dönüş için URL şeması. Bu değer olmadan
		     Google girişi geri dönemez, kullanıcı beyaz ekranda kalır. -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>REVERSED_CLIENT_ID_YER_TUTUCU</string>
				</array>
			</dict>
		</array>

		<!-- ── Şifreleme beyanı ─────────────────────────────────────────────
		     Uygulama yalnızca standart HTTPS kullanıyor. Bu anahtar olmadan
		     her yüklemede Apple manuel olarak soruyor ve süreç bekliyor. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>

		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>

		<!-- Uygulama main.dart içinde yalnızca dikey yönü kilitliyor;
		     plist de aynı şeyi söylemeli, aksi halde açılış karesi yatay
		     çizilip zıplıyor. -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>

		<!-- UISupportedInterfaceOrientations~ipad BİLEREK YOK.
		     TARGETED_DEVICE_FAMILY = 1 — uygulama yalnızca iPhone'u
		     hedefliyor. iPad anahtarı bırakılırsa Apple, iPad desteği
		     beyan edildiğini varsayıp inceleme sırasında iPad ekran
		     görüntüsü ister. -->

		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>

		<!-- Koyu temaya sabit — uygulama dark-first tasarlandı. -->
		<key>UIUserInterfaceStyle</key>
		<string>Dark</string>
	</dict>
</plist>
