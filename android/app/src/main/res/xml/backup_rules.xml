<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 ve altı için yedekleme kuralları (allowBackup=false ile birlikte
  savunma katmanı).

  Liqra finansal veri tutuyor: hesap bakiyeleri, kart borçları, işlem geçmişi.
  Bunların cihaz yedeğine (Google Drive) çıkması istenmez — veri zaten
  Firestore'da kullanıcının kendi hesabında duruyor ve yeni cihazda girişle
  geri geliyor. Yedeğe kopyalamak sadece saldırı yüzeyi büyütür.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
